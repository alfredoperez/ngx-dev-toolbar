# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
out-tsc
.astro/

# Version-compatibility sandboxes: the demo-app copy + per-version package.json/
# angular.json/tsconfig ARE committed; generated install/build output is not.
# (node_modules, dist, .angular, out-tsc are already covered by the globs above.)
sandboxes/**/package-lock.json

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

